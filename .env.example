CDSE_CLIENT_ID=your-sentinel-hub-client-id
CDSE_CLIENT_SECRET=your-sentinel-hub-client-secret
GFW_API_TOKEN=your-global-fishing-watch-api-token
# Optional alternative to running `copernicusmarine login` once.
COPERNICUSMARINE_SERVICE_USERNAME=your-copernicus-marine-username
COPERNICUSMARINE_SERVICE_PASSWORD=your-copernicus-marine-password

# Optional live incident email delivery; leave empty until administrator setup.
WAKE_TRACE_SMTP_HOST=
WAKE_TRACE_SMTP_PORT=587
WAKE_TRACE_SMTP_FROM=
WAKE_TRACE_SMTP_USERNAME=
WAKE_TRACE_SMTP_PASSWORD=
WAKE_TRACE_NOTIFICATION_APPROVAL_TOKEN=
WAKE_TRACE_NOTIFICATION_ALLOWLIST=
